{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "public/js/{core,seed}.js"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=:path*" }
  ],
  "redirects": [
    { "source": "/shop", "destination": "/shop/", "permanent": false },
    { "source": "/b2b", "destination": "/b2b/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 5 * * *" }
  ]
}
